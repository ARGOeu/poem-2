#!/usr/bin/env python

import argparse
import os
import pwd
import sys


RUN_AS_USER = "apache"


def build_parser():
    parser = argparse.ArgumentParser(
        prog="poem-db",
        usage="%(prog)s [argument]",
        add_help=False,
    )
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("-a", action="store_true", help="apply new migration")
    actions.add_argument("-c", action="store_true", help="create database")
    actions.add_argument("-l", action="store_true", help="list migrations")
    actions.add_argument("-m", action="store_true", help="create new migration")
    actions.add_argument(
        "-o", action="store_true",
        help="apply migrations from other apps",
    )
    actions.add_argument(
        "-s", action="store_true",
        help="clear stale login sessions",
    )
    actions.add_argument("-x", action="store_true", help="just load fixtures")
    actions.add_argument("-u", action="store_true", help="create superuser")
    actions.add_argument("-d", action="store_true", help="load data from file")
    actions.add_argument("-p", action="store_true", help="dump data to file")
    actions.add_argument(
        "-i", action="store_true",
        help="import internal metrics",
    )
    actions.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-n", dest="schema", metavar="<schema name>")
    parser.add_argument(
        "-f",
        dest="file_or_fake",
        nargs="?",
        const=True,
        metavar="<file path>",
    )
    parser.add_argument(
        "--run-as-user",
        default=RUN_AS_USER,
        metavar="<user>",
        help="effective user used for commands that used to run via su",
    )
    return parser


def print_usage(parser):
    parser.print_usage(sys.stderr)
    print("       [-a]                                  - apply new migration", file=sys.stderr)
    print("       [-c]                                  - create database", file=sys.stderr)
    print("       [-f]                                  - mark migrations as run without running them", file=sys.stderr)
    print("       [-h]                                  - usage", file=sys.stderr)
    print("       [-l]                                  - list migrations", file=sys.stderr)
    print("       [-m]                                  - create new migration", file=sys.stderr)
    print("       [-o]                                  - apply migrations from other apps", file=sys.stderr)
    print("       [-s] -n <schema name>                 - clear stale login sessions", file=sys.stderr)
    print("       [-x] -n <schema name>                 - just load fixtures", file=sys.stderr)
    print("       [-u] -n <schema name>                 - create superuser", file=sys.stderr)
    print("       [-d] -n <schema name> -f <file path>  - load data from file", file=sys.stderr)
    print("       [-p] -n <schema name> -f <file path>  - dump data to file", file=sys.stderr)
    print("       [-i] -n <schema name>                 - import internal metrics", file=sys.stderr)
    print("       [--run-as-user]                       - effective user (default: apache)", file=sys.stderr)


def setup_django():
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "Poem.settings")

    import django

    django.setup()


def drop_privileges(user):
    target_user = pwd.getpwnam(user)
    if os.getuid() == target_user.pw_uid:
        return

    os.setgid(target_user.pw_gid)
    os.initgroups(user, target_user.pw_gid)
    os.setuid(target_user.pw_uid)


def call_management_command(command, *args, **options):
    from django.core.management import call_command

    call_command(command, *args, **options)


def run_command(command, *args, **options):
    setup_django()
    call_management_command(command, *args, **options)
    return 0


def run_command_as(user, command, *args, **options):
    pid = os.fork()

    if pid == 0:
        try:
            drop_privileges(user)
            setup_django()
            call_management_command(command, *args, **options)
        except Exception as exc:
            print(exc, file=sys.stderr)
            os._exit(1)
        os._exit(0)

    _, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    return 1


def run_many_as(user, commands):
    for command in commands:
        result = run_command_as(user, *command[0], **command[1])
        if result != 0:
            return result
    return 0


def require_schema(parser, schema):
    if not schema:
        print("Schema name should be given!", file=sys.stderr)
        print_usage(parser)
        raise SystemExit(2)


def require_filename(parser, filename):
    if not filename or filename is True:
        print("File path should be given!", file=sys.stderr)
        print_usage(parser)
        raise SystemExit(2)


def create_database(user):
    return run_many_as(user, [
        (("migrate_schemas",), {"shared": True}),
        (("poem_create_tenant",), {"name": "all"}),
        (
            ("tenant_command", "loaddata", "initial_data_public.json"),
            {"schema": "public"},
        ),
    ])


def apply_new_migration(user):
    return run_many_as(user, [
        (("migrate_schemas",), {"shared": True}),
        (("migrate_schemas", "poem"), {"tenant": True}),
    ])


def apply_other_migrations(user):
    return run_many_as(user, [
        (("makemigrations",), {}),
        (("migrate_schemas",), {"tenant": True}),
    ])


def dump_data(schema, filename):
    setup_django()

    options = {
        "indent": 2,
        "natural_foreign": True,
        "natural_primary": True,
        "schema": schema,
    }
    if schema == "public":
        options["exclude"] = ["tenants.tenant", "tenants.domain"]

    with open(filename, "w") as output:
        call_management_command(
            "tenant_command",
            "dumpdata",
            stdout=output,
            **options,
        )
    return 0


def selected_action(args):
    for action in (
        "a", "c", "l", "m", "o", "s", "x", "u", "d", "p", "i",
    ):
        if getattr(args, action):
            return action
    if args.file_or_fake is True:
        return "fake"
    return None


def main(argv=None):
    parser = build_parser()
    argv = sys.argv[1:] if argv is None else argv

    if not argv:
        print_usage(parser)
        return 2

    args = parser.parse_args(argv)

    if args.help:
        print_usage(parser)
        return 2

    action = selected_action(args)
    if not action:
        print_usage(parser)
        return 2

    if action == "c":
        return create_database(args.run_as_user)

    if action == "u":
        require_schema(parser, args.schema)
        return run_command_as(
            args.run_as_user,
            "tenant_command",
            "poem_superuser",
            schema=args.schema,
        )

    if action == "m":
        return run_command("makemigrations", "poem")

    if action == "fake":
        return run_command_as(
            args.run_as_user,
            "migrate_schemas",
            tenant=True,
            fake=True,
        )

    if action == "a":
        return apply_new_migration(args.run_as_user)

    if action == "l":
        return run_command_as(
            args.run_as_user,
            "showmigrations",
            "poem",
            "poem_super_admin",
            "users",
            "tenants",
        )

    if action == "s":
        require_schema(parser, args.schema)
        return run_command_as(
            args.run_as_user,
            "tenant_command",
            "clearsessions",
            schema=args.schema,
        )

    if action == "o":
        return apply_other_migrations(args.run_as_user)

    if action == "x":
        require_schema(parser, args.schema)
        return run_command_as(
            args.run_as_user,
            "tenant_command",
            "loaddata",
            "initial_data.json",
            schema=args.schema,
        )

    if action == "d":
        require_schema(parser, args.schema)
        require_filename(parser, args.file_or_fake)
        return run_command_as(
            args.run_as_user,
            "tenant_command",
            "loaddata",
            args.file_or_fake,
            schema=args.schema,
        )

    if action == "p":
        require_schema(parser, args.schema)
        require_filename(parser, args.file_or_fake)
        return dump_data(args.schema, args.file_or_fake)

    if action == "i":
        require_schema(parser, args.schema)
        if args.schema == "public":
            print("You cannot import metrics to public schema!!")
            return 1
        return run_command_as(
            args.run_as_user,
            "tenant_command",
            "import_internal_metrics",
            schema=args.schema,
        )

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
